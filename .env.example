VITE_API_URL=http://localhost:8080/api

# Client ID público de Google Cloud para "Continuar con Google" (no es un secreto, pero tampoco se commitea el real).
# Es una variable de build: hay que recompilar (o reiniciar el servidor de desarrollo) al cambiarla.
# Si queda vacía, el botón de Google y el separador "o continuá con" no se muestran.
VITE_GOOGLE_CLIENT_ID=
